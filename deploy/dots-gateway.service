[Unit]
Description=Dots <-> Local Dev & Antigravity (agy) Hardened HTTPS/WSS Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gateway
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/env python3 -u %h/gateway/main.py --config %h/gateway/config.json
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=default.target
