{
  "host": "0.0.0.0",
  "port": 8765,
  "loopback_http_port": 18765,
  "public_ip": null,
  "api_tokens": [
    "dots_gw_<AUTO_GENERATED_ON_FIRST_RUN>"
  ],
  "users": {
    "dots": "pbkdf2_sha256$<SALT>$<HASH>"
  },
  "hmac_secret": "<AUTO_GENERATED_64_HEX_SECRET>",
  "hmac_max_skew_seconds": 300,
  "allow_query_token": false,
  "minimal_unauth_health": true,
  "allowed_client_ips": [],
  "trusted_proxies": [],
  "rate_limit_max_failures": 10,
  "rate_limit_window_seconds": 60,
  "oauth_allowed_redirect_hosts": [
    "chatgpt.com",
    "*.chatgpt.com",
    "openai.com",
    "*.openai.com",
    "claude.ai",
    "*.claude.ai",
    "localhost",
    "127.0.0.1",
    "::1"
  ],
  "enforce_allowlist": true,
  "allowed_workdirs": [
    "/home/<your-user>/workspaces"
  ],
  "default_workdir": "/home/<your-user>/workspaces",
  "isolate_mount_namespace": true,
  "agy_binary": "/home/<your-user>/.local/bin/agy",
  "agy_default_skip_permissions": true,
  "agy_default_sandbox": true,
  "agy_sandbox_tool_permission": "proceed-in-sandbox",
  "agy_include_allowed_workdirs": true,
  "agy_extra_workspace_dirs": [],
  "agy_extra_readonly_roots": [],
  "agy_env_file": "/home/<your-user>/.config/dots-gateway/agy.env",
  "agy_default_model": null,
  "agy_model_file": "/home/<your-user>/.config/dots-gateway/agy.model",
  "agy_models_cache_seconds": 300.0,
  "agy_plugins_enabled": false,
  "agy_plugin_dirs": [],
  "agy_plugins_file": "/home/<your-user>/.config/dots-gateway/agy-plugins.json",
  "agent_runtime_home_root": "/mnt/dots-agent-home",
  "plugin_state_dir": null,
  "codex_binary": "/usr/local/bin/codex",
  "bwrap_binary": "/usr/local/bin/bwrap",
  "codex_default_skip_permissions": true,
  "codex_default_sandbox": "workspace-write",
  "codex_sandbox_network_access": true,
  "codex_extra_writable_roots": [],
  "codex_env_file": "/home/<your-user>/.config/dots-gateway/codex.env",
  "codex_plugins_enabled": false,
  "codex_plugin_dirs": [],
  "codex_plugins_file": "/home/<your-user>/.config/dots-gateway/codex-plugins.json",
  "docker_enabled": false,
  "docker_mode_file": "/home/<your-user>/.config/dots-gateway/docker.mode",
  "docker_upstream_socket": "/var/run/docker.sock",
  "docker_proxy_socket": "/home/<your-user>/.config/dots-gateway/docker-proxy.sock",
  "docker_force_loopback_ports": true,
  "docker_allow_host_network": true,
  "docker_allowed_capabilities": [],
  "docker_extra_bind_roots": [],
  "max_concurrent_agy": 4,
  "max_concurrent_codex": 6,
  "agy_queue_timeout_seconds": 28800.0,
  "sandbox_state_dir": "/home/<your-user>/.cache/dots-sandbox",
  "sandbox_lock_timeout_seconds": 5.0,
  "sandbox_cleanup_enabled": true,
  "sandbox_cleanup_interval_seconds": 3600.0,
  "sandbox_max_retention_days": 30.0,
  "sandbox_min_retention_days": 7.0,
  "sandbox_low_space_free_gb": 8.0,
  "sandbox_low_space_free_percent": 15.0,
  "session_state_dir": "/home/<your-user>/.config/dots-gateway/sessions",
  "max_persisted_sessions": 200,
  "default_timeout_seconds": 21600.0,
  "agent_default_timeout_seconds": 28800.0,
  "max_timeout_seconds": 86400.0,
  "max_concurrent_sessions": 32,
  "max_concurrent_connections": 128,
  "max_output_buffer_events": 5000,
  "max_output_bytes": 33554432,
  "sse_keepalive_seconds": 15.0,
  "tls_certfile": "certs/server.crt",
  "tls_keyfile": "certs/server.key",
  "tls_ca_file": "certs/ca.crt",
  "tls_require_client_cert": false
